// Elegancy Modas — schema do banco (PostgreSQL / Neon)
// Valores monetários: Decimal(10,2). Estoque: sempre por variação (tamanho + cor).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────── Enums ─────────────

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PAID
  SHIPPED
  DELIVERED
  CANCELED
}

enum StockMovementType {
  INITIAL
  ENTRY
  SALE
  ADJUSTMENT
  RETURN
  CANCELLATION
}

// ───────────── Administração ─────────────

model Admin {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  passwordHash     String
  active           Boolean  @default(true)
  // Incrementar invalida todas as sessões emitidas (troca de senha, logout global).
  tokenVersion     Int      @default(0)
  failedLoginCount Int      @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  stockMovements StockMovement[]
}

// ───────────── Catálogo ─────────────

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([active, sortOrder])
}

model Product {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  description    String?
  sku            String?       @unique
  price          Decimal       @db.Decimal(10, 2)
  compareAtPrice Decimal?      @db.Decimal(10, 2)
  status         ProductStatus @default(DRAFT)
  featured       Boolean       @default(false)
  categoryId     String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Restrict: não é possível apagar uma categoria que ainda tenha produtos.
  category   Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  variants   ProductVariant[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([status, featured])
  @@index([createdAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  // Caminho no Vercel Blob, necessário para exclusão posterior.
  pathname  String
  alt       String?
  position  Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  size      String
  colorName String
  colorHex  String?
  sku       String?  @unique
  // Saldo atual. Alterações devem sempre gerar um StockMovement (ver services de estoque).
  stock     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements  StockMovement[]
  orderItems OrderItem[]

  // Uma combinação tamanho + cor por produto. Peça sem variação usa "Único".
  @@unique([productId, size, colorName])
  @@index([productId])
  @@index([active, stock])
}

// ───────────── Pedidos ─────────────

model Order {
  id           String      @id @default(cuid())
  // Número sequencial legível para o cliente e para a mensagem do WhatsApp.
  number       Int         @unique @default(autoincrement())
  status       OrderStatus @default(PENDING)
  customerName  String
  customerPhone String
  customerNote  String?
  subtotal     Decimal     @db.Decimal(10, 2)
  discount     Decimal     @default(0) @db.Decimal(10, 2)
  total        Decimal     @db.Decimal(10, 2)
  whatsappSentAt DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  items          OrderItem[]
  stockMovements StockMovement[]

  @@index([status, createdAt])
  @@index([customerPhone])
  @@index([createdAt])
}

// Snapshot: nome, preço, tamanho e cor são copiados no momento da compra.
// As referências a produto/variação são opcionais para sobreviver a exclusões.
model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  variantId   String?
  productName String
  productSku  String?
  size        String
  colorName   String
  imageUrl    String?
  unitPrice   Decimal  @db.Decimal(10, 2)
  quantity    Int
  lineTotal   Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
  @@index([productId])
}

// ───────────── Estoque ─────────────

// Histórico imutável. quantity é o delta (positivo entra, negativo sai).
model StockMovement {
  id           String            @id @default(cuid())
  variantId    String
  type         StockMovementType
  quantity     Int
  balanceAfter Int
  reason       String?
  orderId      String?
  adminId      String?
  createdAt    DateTime          @default(now())

  // Restrict: variação com histórico deve ser desativada, nunca apagada.
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  admin   Admin?         @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([orderId])
  @@index([adminId])
}

// ───────────── Configurações e banners ─────────────

// Registro único (id fixo "default").
model StoreSettings {
  id             String   @id @default("default")
  storeName      String   @default("Elegancy Modas")
  whatsappNumber String?
  email          String?
  instagram      String?
  address        String?
  about          String?
  logoUrl        String?
  currency       String   @default("BRL")
  updatedAt      DateTime @updatedAt
}

model Banner {
  id             String    @id @default(cuid())
  title          String
  subtitle       String?
  imageUrl       String
  imagePathname  String
  mobileImageUrl String?
  mobilePathname String?
  linkUrl        String?
  position       Int       @default(0)
  active         Boolean   @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([active, position])
}
